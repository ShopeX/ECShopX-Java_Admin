{
  "openapi": "3.0.1",
  "info": {
    "title": "AdminAPI",
    "description": "由《抽奖-接口契约.md》整理而成的 OpenAPI 文档。\n说明：AdminAuth 与 FrontAuth 共享同一套抽奖业务语义，但 base path 不同。\n",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "语言设置"
    }
  ],
  "paths": {
    "/api/v1/setting/language": {
      "get": {
        "summary": "读取语言配置（配置页）",
        "deprecated": false,
        "description": "routeAlias: setting.language.get\n固定返回四种语言（含 enabled=false）；无 Redis 键时 version=0，仅 zh-CN 启用。\n",
        "operationId": "settingLanguageGet",
        "tags": [
          "语言设置"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功或业务错误（422 时 body.data.status_code=422）",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResultLanguageAdminSetting"
                    },
                    {
                      "$ref": "#/components/schemas/Dingo422Response"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "无 Redis 键缺省",
                    "value": {
                      "code": 200,
                      "msg": "success",
                      "data": {
                        "version": 0,
                        "configValid": true,
                        "configWarning": null,
                        "defaultLanguage": "zh-CN",
                        "enabledCount": 1,
                        "languages": [
                          {
                            "code": "zh-CN",
                            "displayName": "中文",
                            "enabled": true,
                            "sort": 1
                          },
                          {
                            "code": "en-CN",
                            "displayName": "English",
                            "enabled": false,
                            "sort": 2
                          },
                          {
                            "code": "ar-SA",
                            "displayName": "العربية",
                            "enabled": false,
                            "sort": 3
                          },
                          {
                            "code": "zh-TW",
                            "displayName": "中文繁体",
                            "enabled": false,
                            "sort": 4
                          }
                        ]
                      }
                    }
                  }
                }
              }
            },
            "headers": {},
            "x-apifox-ordering": 0
          },
          "401": {
            "description": "未登录 / 无权限",
            "headers": {},
            "x-apifox-ordering": 1
          }
        },
        "security": [],
        "x-apifox-folder": "语言设置",
        "x-apifox-status": "released",
        "x-run-in-apifox": "https://app.apifox.com/web/project/8796324/apis/api-511492204-run"
      },
      "post": {
        "summary": "保存语言配置",
        "deprecated": false,
        "description": "routeAlias: setting.language.set\n全量替换 Redis；已有配置时 body.version 必填且与 GET 一致。\n",
        "operationId": "settingLanguageSet",
        "tags": [
          "语言设置"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LanguageSettingSaveRequest"
              },
              "example": {
                "version": 1,
                "defaultLanguage": "zh-CN",
                "languages": [
                  {
                    "code": "zh-CN",
                    "enabled": true
                  },
                  {
                    "code": "en-CN",
                    "enabled": true
                  },
                  {
                    "code": "ar-SA",
                    "enabled": false
                  },
                  {
                    "code": "zh-TW",
                    "enabled": false
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "成功或业务错误（422）",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResultLanguageSaveResult"
                    },
                    {
                      "$ref": "#/components/schemas/Dingo422Response"
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "summary": "success",
                    "value": {
                      "code": 200,
                      "msg": "success",
                      "data": {
                        "result": true,
                        "version": 2,
                        "defaultLanguage": "zh-CN",
                        "enabledCount": 2,
                        "message": "语言设置已保存",
                        "languages": [
                          {
                            "code": "zh-CN",
                            "displayName": "中文",
                            "enabled": true,
                            "sort": 1
                          },
                          {
                            "code": "en-CN",
                            "displayName": "English",
                            "enabled": true,
                            "sort": 2
                          }
                        ]
                      }
                    }
                  },
                  "versionConflict": {
                    "summary": "乐观锁冲突",
                    "value": {
                      "data": {
                        "message": "配置已被他人修改，请刷新后重试",
                        "status_code": 422
                      }
                    }
                  }
                }
              }
            },
            "headers": {},
            "x-apifox-ordering": 0
          },
          "401": {
            "description": "未登录 / 无权限",
            "headers": {},
            "x-apifox-ordering": 1
          }
        },
        "security": [],
        "x-apifox-folder": "语言设置",
        "x-apifox-status": "released",
        "x-run-in-apifox": "https://app.apifox.com/web/project/8796324/apis/api-511492205-run"
      }
    }
  },
